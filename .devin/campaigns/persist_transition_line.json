{
  "name": "persist_transition_line",
  "experiment": "o_persist_on_transition_line",
  "task": {
    "generator": {
      "kind": "polymer",
      "max_len": 4,
      "alphabet_size": 2,
      "p_cat": 0.6,
      "p_info": 0.7,
      "p_selfrep": 0.3,
      "ligation": true,
      "n_cat_max": 3,
      "p_multi": 0.5,
      "chi": 0.7,
      "delta_mu": 4.0,
      "kappa": 500.0,
      "cat_power": 2
    },
    "eps": 0.0,
    "assembly": {"mass_floor": 0.01},
    "reactor": {
      "type": "cstr",
      "t_max": 400.0,
      "x0_policy": "dense",
      "multistability": {"n_ic": 16, "min_mass": 0.01, "t_max": 400.0}
    },
    "stochastic": {
      "enabled": true,
      "replicates": 3,
      "volume": 64,
      "t_max": 200.0,
      "max_events": 1500000,
      "theta_organized": 0.1,
      "mass_floor": 0.01,
      "x0_from": "reactor"
    }
  },
  "sweeps": [
    {"param": "reactor.dilution",
     "values": [0.3, 0.5, 0.7, 0.9]}
  ],
  "control_axis": {"param": "reactor.dilution",
                   "direction": "negate", "label": "inv_dilution"},
  "n_networks": 8,
  "order_parameter": "equilibrium.m_poly",
  "summarize_mode": "cocriticality",
  "out_dir": "data/validation"
}
